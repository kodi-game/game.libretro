msgctxt "Addon Summary"
msgid "Libretro compatibility layer for Kodi's Game API"
msgstr "Vrstva kompatibility libretro pro herní API Kodi"

msgctxt "Addon Description"
msgid "This add-on provides a wrapper for libretro cores, allowing them to be loaded as game add-ons."
msgstr "Tento doplněk poskytuje obalovou vrstvu pro jádra libretro a umožňuje je načítat jako herní doplňky."

msgctxt "#30000"
msgid "Crop overscan"
msgstr "Oříznout overscan"

msgctxt "#30001"
msgid "Crop away invisible edges of the screen, if the game is aware of any."
msgstr "Ořízne neviditelné okraje obrazovky, pokud je hra dokáže určit."

msgctxt "#30002"
msgid "BIOS and system files"
msgstr "BIOS a systémové soubory"

msgctxt "#30003"
msgid "Use shared System/BIOS folder"
msgstr "Používat sdílenou složku pro systémové soubory a BIOS"

msgctxt "#30004"
msgid "Use a shared System/BIOS folder for all libretro cores, instead of a folder for each core. A core's own system folder is not used, so any system files from it have to be copied to the shared folder."
msgstr "Použije pro všechna jádra libretro sdílenou složku pro systémové soubory a BIOS místo samostatné složky pro každé jádro. Vlastní složka jádra se systémovými soubory se nepoužívá, takže všechny systémové soubory z ní je nutné zkopírovat do sdílené složky."

msgctxt "#30005"
msgid "Shared folder"
msgstr "Sdílená složka"

msgctxt "#30006"
msgid "The folder every emulator looks in for BIOS and other system files."
msgstr "Složka, ve které každý emulátor hledá BIOS a další systémové soubory."
